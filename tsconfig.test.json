{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "rootDir": "src",
    "outDir": "out/tests"
  },
  "include": ["src/main/database/**/*.ts", "src/main/sync/**/*.ts", "src/main/excel/**/*.ts", "src/shared/**/*.ts", "src/preload/api.d.ts"]
}
