[Unit]
Description=PriceDesk quote API
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pricedesk-api
Group=pricedesk-api
WorkingDirectory=/opt/pricedesk-api/current/server
EnvironmentFile=/etc/pricedesk/api.env
ExecStart=/usr/bin/node /opt/pricedesk-api/current/server/dist/server/src/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
StateDirectory=pricedesk
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
